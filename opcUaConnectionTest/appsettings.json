    "NLog": {
        "autoReload": true,
        "throwConfigExceptions": true,
        "internalLogLevel": "Warn",
        "internalLogFile": "${basedir}/Logs/internal-nlog.log",
        "extensions": [
            {
                "assembly": "NLog.Extensions.Logging"
            },
            {
                "assembly": "NLog.Web.AspNetCore"
            }
        ],
        "variables": {
            "logFileDirectory": "${basedir}/Logs",
            "logName": "Integration-EMMS",
            "logErrorName": "${logName}-Error",
            "logInfoName": "${logName}-Info",
            "minLogLevel": "Info"
        },
        "targets": {
            "async": true,
            "logErrorFile": {
                "type": "File",
                "fileName": "${logFileDirectory}/${logErrorName}.log",
                "archiveFileName": "${logFileDirectory}/${logErrorName}/${logErrorName}.{#}.log",
                "archiveNumbering": "DateAndSequence",
                "archiveDateFormat": "yyyyMMdd",
                "archiveAboveSize": 52428800,
                "archiveOldFileOnStartup": true,
                "maxArchiveDays": 30,
                "layout": "${longdate} | ${level} | ${logger} | ${message} ${exception:format=tostring}"
            },
            "logInfoFile": {
                "type": "File",
                "fileName": "${logFileDirectory}/${logInfoName}.log",
                "archiveFileName": "${logFileDirectory}/${logInfoName}/${logInfoName}.{#}.log",
                "archiveNumbering": "DateAndSequence",
                "archiveDateFormat": "yyyyMMdd",
                "archiveAboveSize": 52428800,
                "archiveOldFileOnStartup": true,
                "maxArchiveFiles": 10,
                "layout": "${longdate} | ${level} | ${logger} | ${message} ${exception:format=tostring}"
            },
            "logConsole": {
                "type": "Console",
                "layout": "${longdate} | ${level} | ${logger} | ${message} ${exception:format=tostring}"
            }
        },
        "rules": [
            // Documentation: https://github.com/nlog/NLog/wiki/Configuration-file
            //
            // Log levels ordered by severity:
            // - Fatal (5)
            // - Error (4)
            // - Warn  (3)
            // - Info  (2)
            // - Debug (1)
            // - Trace (0)
            //
            // Briefly: add rules to customize behavior for certain sources.
            // > Use 'logger', 'minLevel', and 'maxLevel', to define a group of log statements.
            // > Use 'writeTo' to send the group to the specified targets (or discard!)
            // > Use 'final' to stop processing that group.
            //
            // Rule for all (include Program content)
            {
                "logger": "PG.LIFT.Integrations.EMMS.Program",
                "minLevel": "Info",
                "final": true,
                "writeTo": "logErrorFile, logInfoFile, logConsole"
            },
            // Default rule for everything (that is not final)
            {
                "logger": "*",
                "minLevel": "${minLogLevel}",
                "writeTo": "logConsole, logInfoFile, logErrorFile"
            },
            // Rule for Info file (exclude)
            {
                "logger": "Microsoft.AspNetCore.*",
                "finalMinLevel": "Warn"
            },
            // Default rule for Info file
            {
                "logger": "*",
                "minLevel": "${minLogLevel}",
                "writeTo": "logInfoFile, logConsole"
            },
            // Default rule for Error file
            {
                "logger": "*",
                "minLevel": "Warn",
                "writeTo": "logErrorFile"
            }
        ]
    }
}
